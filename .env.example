# ---------------------------------------------------------------------------
# PenguinHQ — environment variables (copy to .env before running)
# ---------------------------------------------------------------------------

# Postgres
POSTGRES_USER=penguin
POSTGRES_PASSWORD=penguin
POSTGRES_DB=penguinhq

# Backend (FastAPI)
DATABASE_URL=postgresql+asyncpg://penguin:penguin@localhost:5432/penguinhq
REDIS_URL=redis://localhost:6379/0
CORS_ORIGINS=http://localhost:3000
ENVIRONMENT=development
API_ACCESS_TOKEN=
AUTO_CREATE_SCHEMA=true
ALLOWED_HOSTS=localhost,127.0.0.1,testserver

# Frontend (Next.js)
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000/ws
NEXT_PUBLIC_DEMO_MODE=false
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional service authentication. Leave blank for local development. In
# production, set this to the same secret as API_ACCESS_TOKEN on the API.
PENGUINHQ_API_TOKEN=

# Autonomous agents — all 4 agents (Job Hunter, Leetcode Coach, Tech Scout,
# Portfolio Penguin) run in the agent-runner container and call Claude via the
# Anthropic API. Without a key, the agent-runner container will crash-loop,
# harmlessly, while everything else (API, web, Postgres, Redis) runs fine.
ANTHROPIC_API_KEY=
# PENGUINHQ_MODEL=claude-haiku-4-5-20251001

# Job Hunter — Apify MCP client. Create the token in your Apify Console and
# keep it in .env only (never commit it).
# APIFY_API_TOKEN=
# APIFY_LINKEDIN_ACTOR=valig/linkedin-jobs-scraper
# APIFY_MCP_URL=https://mcp.apify.com/?tools=actors,docs,valig/linkedin-jobs-scraper
# Leave empty to auto-discover the configured actor tool at startup. Set this
# only if Apify returns a different tool name in your environment.
# APIFY_MCP_TOOL_NAME=
# APIFY_MCP_TIMEOUT_SECONDS=120
#
# Default query: up to 10 recently posted Site Reliability Engineer roles in Singapore.
# Searches share the daily 10-listing allowance.
# LINKEDIN_JOB_KEYWORDS=Site Reliability Engineer, Production Engineer, MLOps, AI Engineer
# LINKEDIN_JOB_LOCATION=Singapore
# LINKEDIN_MAX_LISTINGS=10
# JOB_HUNTER_DAILY_LIMIT=10
# MAX_EXPERIENCE_YEARS=7

# Tech Scout — three basic Tavily searches each UTC day (about 90 credits/month).
# TAVILY_MCP_URL=https://mcp.tavily.com/mcp/
# TAVILY_API_KEY=
# TECH_SCOUT_DAILY_TAVILY_CREDIT_LIMIT=3
