# ---------------------------------------------------------------------------
# PenguinHQ — environment variables (copy to .env before running)
# ---------------------------------------------------------------------------

# Postgres
POSTGRES_USER=penguin
POSTGRES_PASSWORD=penguin
POSTGRES_DB=penguinhq

# Backend (FastAPI)
DATABASE_URL=postgresql+asyncpg://penguin:penguin@localhost:5432/penguinhq
REDIS_URL=redis://localhost:6379/0
CORS_ORIGINS=http://localhost:3000
ENVIRONMENT=development

# Frontend (Next.js)
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000/ws

# Auth (wired in a later milestone)
# CLERK_SECRET_KEY=
# NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=

# Leetcode Coach — the one genuinely autonomous agent (apps/api/app/autonomous).
# It calls Claude itself in a loop; without a key, the leetcode-coach
# container will just crash-loop, harmlessly, while everything else runs fine.
ANTHROPIC_API_KEY=
# LEETCODE_COACH_MODEL=claude-haiku-4-5-20251001
# LEETCODE_COACH_INTERVAL_SECONDS=120
