# Development image: hot reload via `uvicorn --reload`.
# A separate multi-stage Dockerfile (prod) ships in the deployment milestone.
FROM python:3.12-slim

WORKDIR /app

# System deps for asyncpg / psycopg build if needed
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    && rm -rf /var/lib/apt/lists/*

COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt
RUN playwright install --with-deps chromium

# Source is bind-mounted over this in docker-compose.yml for hot reload;
# COPY here so the image also works standalone (`docker run`).
COPY . .

EXPOSE 8000

CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000", "--reload"]
