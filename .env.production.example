# Copy to .env.production and replace every CHANGE_ME value.
POSTGRES_USER=penguin
POSTGRES_PASSWORD=CHANGE_ME_WITH_A_LONG_RANDOM_VALUE
POSTGRES_DB=penguinhq
PENGUINHQ_API_TOKEN=CHANGE_ME_WITH_AT_LEAST_32_RANDOM_BYTES

# Public URL. Caddy obtains HTTPS automatically when SITE_ADDRESS is a domain.
SITE_ADDRESS=demo.example.com
SITE_URL=https://demo.example.com

# Optional. Only needed with: docker compose ... --profile agents up
ANTHROPIC_API_KEY=
